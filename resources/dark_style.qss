/* =========================================================
   Medical ERP V2 - DARK THEME
   ---------------------------------------------------------
   Same rule as style.qss (Light): every background pairs
   with an explicit foreground. Nothing inherits from the
   OS palette.
   ========================================================= */

* {
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10.5pt;
    color: #E6EDF7;
}

QMainWindow, QDialog, QWidget {
    background-color: #12161F;
    color: #E6EDF7;
}

/* ---------- Brand header / footer bars ---------- */
QFrame#frmHeader, QFrame#frmTopHeader, QFrame#frmFooter {
    background-color: #0A0E16;
    color: #E6EDF7;
}
QFrame#frmHeader QLabel, QFrame#frmTopHeader QLabel, QFrame#frmFooter QLabel {
    color: #E6EDF7;
    background: transparent;
}

/* ---------- Left branding panel (Login) ---------- */
QFrame#frmLeftPanel {
    background-color: #171C29;
    color: #C7CEDA;
}
QFrame#frmLeftPanel QLabel {
    color: #C7CEDA;
    background: transparent;
}
QLabel#lblWelcomeMessage {
    color: #FFFFFF;
    font-size: 16pt;
    font-weight: 700;
}
QLabel#lblTagline {
    color: #7C8AA8;
    font-style: italic;
}

/* ---------- Login card / Sidebar (dark surfaces) ---------- */
QFrame#frmLoginPanel, QFrame#frmSidebar, QFrame#loginCard {
    background-color: #1B2130;
    color: #E6EDF7;
    border-radius: 10px;
}
QFrame#frmLoginPanel QLabel, QFrame#frmSidebar QLabel, QFrame#loginCard QLabel {
    color: #E6EDF7;
    background: transparent;
}

QLabel {
    color: #E6EDF7;
    background: transparent;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    padding: 6px 14px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #4A90FF;
    color: #FFFFFF;
}
QPushButton:pressed {
    background-color: #2563EB;
    color: #FFFFFF;
}
QPushButton:disabled {
    background-color: #2E3648;
    color: #6B7690;
}

QPushButton[flat="true"] {
    background-color: transparent;
    color: #7AA6FF;
    text-decoration: underline;
    padding: 4px 6px;
}
QPushButton[flat="true"]:hover {
    color: #A9C6FF;
    background-color: transparent;
}

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QSpinBox, QDateEdit {
    padding: 5px 7px;
    border: 1px solid #2E3648;
    border-radius: 2px;
    background-color: #232A3B;
    color: #E6EDF7;
    selection-background-color: #3B82F6;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #3B82F6;
}
QLineEdit::placeholder {
    color: #7C8AA8;
}
QComboBox QAbstractItemView {
    background-color: #232A3B;
    color: #E6EDF7;
    border: 1px solid #2E3648;
    selection-background-color: #3B82F6;
    selection-color: #FFFFFF;
}

/* ---------- Checkboxes / Radio ---------- */
QCheckBox, QRadioButton {
    color: #E6EDF7;
    background: transparent;
    spacing: 6px;
}

/* ---------- Group boxes ---------- */
QGroupBox {
    color: #E6EDF7;
    font-weight: 600;
    border: none;
    border-top: 1px solid #2E3648;
    border-radius: 0px;
    margin-top: 8px;
    padding-top: 10px;
    background-color: transparent;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #E6EDF7;
    background-color: #1B2130;
}

/* ---------- KPI cards ---------- */
QFrame[cssClass="kpiCard"] {
    background-color: #1B2130;
    border: 1px solid #2E3648;
    border-radius: 10px;
}
QFrame[cssClass="kpiCard"] QLabel[cssClass="kpiTitle"] {
    color: #9AA6BF;
    font-weight: 600;
    font-size: 9.5pt;
}
QFrame[cssClass="kpiCard"] QLabel[cssClass="kpiValue"] {
    color: #FFFFFF;
    font-weight: 700;
    font-size: 16pt;
}

/* ---------- Lists / Trees / Tables ---------- */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #1B2130;
    color: #E6EDF7;
    border: none;
    border-radius: 0px;
    alternate-background-color: #20263A;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    color: #E6EDF7;
    padding: 5px 6px;
    border-radius: 0px;
}
QTreeWidget::item:hover {
    background-color: #232A3B;
}
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
}
QHeaderView::section {
    background-color: #0A0E16;
    color: #E6EDF7;
    padding: 6px;
    border: none;
    font-weight: 600;
}

/* ---------- ScrollArea / Splitter ---------- */
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: transparent;
    border: 1px solid #2E3648;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    border: 1px solid #3B82F6;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: transparent;
    border: 1px solid #2E3648;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    border: 1px solid #3B82F6;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
QSplitter::handle {
    background-color: #2E3648;
}

/* ---------- Status bar ---------- */
QStatusBar {
    background-color: #0A0E16;
    color: #E6EDF7;
}
QStatusBar QLabel {
    color: #E6EDF7;
}

/* ---------- Menu ---------- */
QMenuBar {
    background-color: #0A0E16;
    color: #E6EDF7;
}
QMenuBar::item {
    background: transparent;
    color: #E6EDF7;
}
QMenuBar::item:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
}
QMenu {
    background-color: #1B2130;
    color: #E6EDF7;
    border: 1px solid #2E3648;
}
QMenu::item:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
}

/* ---------- Feedback labels ---------- */
QLabel#lblLoginMessage {
    color: #FF6B6B;
    font-weight: 600;
}
QLabel#lblCapsLock {
    color: #E0B84D;
    font-weight: 600;
}
QLabel#lblConnectionStatus {
    color: #4ADE80;
    font-weight: 600;
}

/* ---------- Tooltips ---------- */
QToolTip {
    background-color: #0A0E16;
    color: #E6EDF7;
    border: 1px solid #3B82F6;
    padding: 4px 8px;
    border-radius: 4px;
}
/* ---------- Dashboard sidebar tree: bigger, bold ---------- */
QTreeWidget#treeSidebarMenu {
    font-size: 11.5pt;
    font-weight: 600;
}
QTreeWidget#treeSidebarMenu::item {
    padding: 6px 4px;
}