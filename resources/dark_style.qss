/* =========================================================
   Medical ERP V2 - DARK THEME
   ---------------------------------------------------------
   Same rule as style.qss (Light): every background pairs
   with an explicit foreground. Nothing inherits from the
   OS palette.
   ========================================================= */

* {
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10.5pt;
    color: #E6EDF7;
}

QMainWindow, QDialog, QWidget {
    background-color: #12161F;
    color: #E6EDF7;
}

/* ---------- Brand header / footer bars ---------- */
QFrame#frmHeader, QFrame#frmTopHeader, QFrame#frmFooter {
    background-color: #0A0E16;
    color: #E6EDF7;
}
QFrame#frmHeader QLabel, QFrame#frmTopHeader QLabel, QFrame#frmFooter QLabel {
    color: #E6EDF7;
    background: transparent;
}

/* ---------- Left branding panel (Login) ---------- */
QFrame#frmLeftPanel {
    background-color: #171C29;
    color: #C7CEDA;
}
QFrame#frmLeftPanel QLabel {
    color: #C7CEDA;
    background: transparent;
}
QLabel#lblWelcomeMessage {
    color: #FFFFFF;
    font-size: 16pt;
    font-weight: 700;
}
QLabel#lblTagline {
    color: #7C8AA8;
    font-style: italic;
}

/* ---------- Login card / Sidebar (dark surfaces) ---------- */
QFrame#frmLoginPanel, QFrame#frmSidebar, QFrame#loginCard {
    background-color: #1B2130;
    color: #E6EDF7;
    border-radius: 10px;
}
QFrame#frmLoginPanel QLabel, QFrame#frmSidebar QLabel, QFrame#loginCard QLabel {
    color: #E6EDF7;
    background: transparent;
}

QLabel {
    color: #E6EDF7;
    background: transparent;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    padding: 6px 14px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #4A90FF;
    color: #FFFFFF;
}
QPushButton:pressed {
    background-color: #2563EB;
    color: #FFFFFF;
}
QPushButton:disabled {
    background-color: #2E3648;
    color: #6B7690;
}

QPushButton[flat="true"] {
    background-color: transparent;
    color: #7AA6FF;
    text-decoration: underline;
    padding: 4px 6px;
}
QPushButton[flat="true"]:hover {
    color: #A9C6FF;
    background-color: transparent;
}

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QSpinBox, QDateEdit {
    padding: 5px 7px;
    border: 1px solid #2E3648;
    border-radius: 2px;
    background-color: #232A3B;
    color: #E6EDF7;
    selection-background-color: #3B82F6;
    selection-color: #FFFFFF;
}
/* ---------- BS Date Field + Calendar Popup ---------- */
QLineEdit[cssClass="dateFieldInput"] {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
}
QToolButton[cssClass="dateFieldButton"] {
    border: 1px solid #2E3648;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-radius: 2px;
    background-color: #232A3B;
    padding: 4px;
}
QToolButton[cssClass="dateFieldButton"]:hover {
    background-color: #2B3348;
}

QDialog[cssClass="bsCalendarPopup"] {
    background-color: #1B2130;
    border: 1px solid #2E3648;
    border-radius: 6px;
}
QToolButton[cssClass="bsCalendarNavButton"] {
    border: none;
    border-radius: 4px;
    background-color: transparent;
    color: #E6EDF7;
    font-weight: bold;
    padding: 4px 8px;
}
QToolButton[cssClass="bsCalendarNavButton"]:hover {
    background-color: #2B3348;
}
QComboBox[cssClass="bsCalendarDropdown"] {
    font-weight: bold;
    color: #E6EDF7;
    background-color: #1A1F2B;
    border: 1px solid #3A4358;
    border-radius: 4px;
    padding: 2px 5px;
}
QLabel[cssClass="bsCalendarWeekdayLabel"] {
    font-weight: bold;
    font-size: 9pt;
    color: #8B96AC;
    padding: 4px 0;
}
QPushButton[cssClass="bsCalendarDayButton"] {
    border: 1px solid #2E3648;
    border-radius: 4px;
    background-color: transparent;
    color: #E6EDF7;
    font-size: 8pt;
    font-weight: bold;
    padding: 0;
    margin: 0;
    min-width: 0;
}
QPushButton[cssClass="bsCalendarDayButton"]:hover {
    background-color: #2B3348;
}
QPushButton[cssClass="bsCalendarDayButton"][dayState="today"] {
    border: 1px solid #3B82F6;
    color: #3B82F6;
    font-weight: bold;
}
QPushButton[cssClass="bsCalendarDayButton"][dayState="selected"] {
    background-color: #3B82F6;
    color: #FFFFFF;
    font-weight: bold;
}
QPushButton[cssClass="bsCalendarDayButton"][dayState="holiday"] {
    color: #E06C6C;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #3B82F6;
}
QLineEdit::placeholder {
    color: #7C8AA8;
}
QComboBox QAbstractItemView {
    background-color: #232A3B;
    color: #E6EDF7;
    border: 1px solid #2E3648;
    selection-background-color: #3B82F6;
    selection-color: #FFFFFF;
}

/* ---------- Checkboxes / Radio ---------- */
QCheckBox, QRadioButton {
    color: #E6EDF7;
    background: transparent;
    spacing: 6px;
}

/* ---------- Group boxes ---------- */
QGroupBox {
    color: #E6EDF7;
    font-weight: 600;
    border: none;
    border-top: 1px solid #2E3648;
    border-radius: 0px;
    margin-top: 8px;
    padding-top: 10px;
    background-color: transparent;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #E6EDF7;
    background-color: #1B2130;
}

/* ---------- KPI cards ---------- */
QFrame[cssClass="kpiCard"] {
    background-color: #1B2130;
    border: 1px solid #2E3648;
    border-radius: 10px;
}
QFrame[cssClass="kpiCard"] QLabel[cssClass="kpiTitle"] {
    color: #9AA6BF;
    font-weight: 600;
    font-size: 9.5pt;
}
QFrame[cssClass="kpiCard"] QLabel[cssClass="kpiValue"] {
    color: #FFFFFF;
    font-weight: 700;
    font-size: 16pt;
}

/* ---------- Dashboard home ---------- */
QFrame#dashboardWelcomeCard {
    background-color: #202A3F;
    border: 1px solid #33415A;
    border-radius: 10px;
}
QLabel#dashboardGreeting {
    background: transparent;
    color: #FFFFFF;
    font-size: 18pt;
    font-weight: 700;
}
QLabel#dashboardDate {
    background: transparent;
    color: #AEBBD1;
    font-size: 9.5pt;
}
QPushButton#dashboardRefreshButton {
    background-color: #2A3448;
    color: #E6EDF7;
    border: 1px solid #46536B;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton#dashboardRefreshButton:hover { background-color: #35425A; }
QGroupBox#grpKpiCards, QGroupBox#grpQuickActions, QGroupBox#grpActivityArea {
    border: none;
    margin-top: 12px;
    padding: 0;
}
QGroupBox#grpKpiCards::title, QGroupBox#grpQuickActions::title,
QGroupBox#grpActivityArea::title {
    left: 0;
    padding: 0 0 8px 0;
    background: transparent;
    color: #F3F6FC;
    font-size: 12pt;
    font-weight: 700;
}
QFrame[cssClass="dashboardMetricCard"] {
    background-color: #1B2130;
    border: 1px solid #2E3648;
    border-left: 4px solid #5B8DEF;
    border-radius: 8px;
}
QFrame[cssClass="dashboardMetricCard"][metricTone="purchase"] { border-left-color: #A78BFA; }
QFrame[cssClass="dashboardMetricCard"][metricTone="stock"] { border-left-color: #34D399; }
QFrame[cssClass="dashboardMetricCard"][metricTone="warning"] { border-left-color: #FBBF24; }
QFrame[cssClass="dashboardMetricCard"][metricTone="expiry"] { border-left-color: #FB7185; }
QFrame[cssClass="dashboardMetricCard"][metricTone="payments"] { border-left-color: #F59E0B; }
QFrame[cssClass="dashboardMetricCard"][metricTone="receipts"] { border-left-color: #22D3EE; }
QFrame[cssClass="dashboardMetricCard"][metricTone="users"] { border-left-color: #94A3B8; }
QLabel[cssClass="dashboardMetricTitle"] {
    color: #9AA6BF;
    font-size: 9pt;
    font-weight: 600;
}
QLabel[cssClass="dashboardMetricValue"] {
    color: #F3F6FC;
    font-size: 17pt;
    font-weight: 700;
}
QPushButton[cssClass="dashboardActionButton"] {
    background-color: #222A3A;
    color: #DCE5F5;
    border: 1px solid #354057;
    border-radius: 6px;
    padding: 8px 12px;
    text-align: left;
    font-weight: 600;
}
QPushButton[cssClass="dashboardActionButton"]:hover {
    background-color: #2B3549;
    border-color: #566784;
}
QPushButton[cssClass="dashboardActionButton"][actionTone="primary"] {
    background-color: #376FD1;
    color: #FFFFFF;
    border-color: #376FD1;
}
QPushButton[cssClass="dashboardActionButton"][actionTone="primary"]:hover { background-color: #4A85E5; }
QPushButton[cssClass="dashboardActionButton"][actionTone="purchase"] {
    background-color: #16836A;
    color: #FFFFFF;
    border-color: #16836A;
}
QPushButton[cssClass="dashboardActionButton"][actionTone="purchase"]:hover { background-color: #1D9C7F; }
QPushButton[cssClass="dashboardActionButton"][actionTone="quiet"] {
    background-color: #252D3E;
    color: #D8E4F8;
}
QGroupBox#grpAlerts, QGroupBox#grpRecentActivity,
QGroupBox#grpFavorites, QGroupBox#grpRecentlyOpened {
    background-color: #1B2130;
    border: 1px solid #2E3648;
    border-radius: 8px;
    margin-top: 8px;
    padding: 14px 10px 10px 10px;
}
QGroupBox#grpAlerts::title, QGroupBox#grpRecentActivity::title,
QGroupBox#grpFavorites::title, QGroupBox#grpRecentlyOpened::title {
    left: 12px;
    padding: 0 5px;
    background-color: #1B2130;
    color: #E6EDF7;
    font-size: 10pt;
    font-weight: 700;
}
QCalendarWidget#purchaseInvoiceCalendar {
    background-color: #1B2130;
    color: #E6EDF7;
    border: 1px solid #354057;
    border-radius: 6px;
    min-width: 248px;
    max-width: 248px;
    min-height: 210px;
    max-height: 210px;
}
QWidget#purchaseCalendarNavigation {
    background-color: #222A3A;
}
QToolButton#purchaseCalendarNavigationButton {
    background-color: #2A3448;
    color: #D8E4F8;
    border: 1px solid #46536B;
    border-radius: 4px;
    min-width: 14px;
    min-height: 22px;
    padding: 0;
    font-weight: 700;
}
QToolButton#purchaseCalendarNavigationButton:hover {
    background-color: #35425A;
}
QComboBox#purchaseCalendarMonth, QComboBox#purchaseCalendarYear {
    background-color: #252D3E;
    color: #E6EDF7;
    border: 1px solid #46536B;
    border-radius: 4px;
    min-height: 24px;
    padding: 1px 12px 1px 3px;
    font-size: 9pt;
}
QComboBox#purchaseCalendarMonth::drop-down, QComboBox#purchaseCalendarYear::drop-down {
    border: none;
    width: 10px;
}
QComboBox#purchaseCalendarMonth::down-arrow, QComboBox#purchaseCalendarYear::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #AEBBD1;
}
QCalendarWidget#purchaseInvoiceCalendar QAbstractItemView {
    background-color: #1B2130;
    color: #E6EDF7;
    selection-background-color: #376FD1;
    selection-color: #FFFFFF;
    outline: 0;
}
QCalendarWidget#purchaseInvoiceCalendar QAbstractItemView:enabled {
    alternate-background-color: #222A3A;
}
QCalendarWidget#purchaseInvoiceCalendar QAbstractItemView::item {
    padding: 1px;
}
QListWidget#dashboardAlerts, QListWidget#dashboardActivityList,
QListWidget#dashboardFavoritesList, QListWidget#dashboardRecentlyOpenedList {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget#dashboardAlerts::item, QListWidget#dashboardActivityList::item,
QListWidget#dashboardFavoritesList::item, QListWidget#dashboardRecentlyOpenedList::item {
    padding: 8px;
    border-bottom: 1px solid #2A3242;
}
QListWidget#dashboardAlerts::item:selected, QListWidget#dashboardActivityList::item:selected,
QListWidget#dashboardFavoritesList::item:selected, QListWidget#dashboardRecentlyOpenedList::item:selected {
    background-color: #2A3448;
    color: #F3F6FC;
}

/* ---------- Purchase invoice entry ---------- */
QFrame#purchaseInvoiceCard {
    background-color: #1B2130;
    color: #E6EDF7;
    border: 1px solid #2E3648;
    border-radius: 8px;
}
QFrame#purchaseInvoiceCard QLabel, QWidget#purchaseInvoiceContent {
    background: transparent;
}
QLabel#purchaseFormTitle, QLabel#purchaseSectionTitle {
    color: #F3F6FC;
    font-weight: 700;
}
QLabel#purchaseFormTitle {
    font-size: 18pt;
}
QLabel#purchaseSectionTitle {
    font-size: 11.5pt;
}
QLabel#purchaseSectionDescription, QLabel#purchaseAttachmentStatus, QLabel#purchaseRoundOff {
    color: #9AA6BF;
    font-size: 9pt;
}
QLabel#purchaseAttachmentStatus[attachmentState="attached"] {
    color: #59C7A4;
    font-weight: 600;
}
QLabel#purchaseLineCount {
    color: #F3F6FC;
    font-weight: 700;
}
QLabel#purchaseGrandTotal, QLabel#purchaseFooterTotal {
    color: #FFFFFF;
    font-weight: 700;
}
QLabel#purchaseGrandTotal {
    font-size: 20pt;
}
QLabel#purchaseFooterTotal {
    font-size: 12pt;
}
QPushButton#purchasePrimaryButton {
    background-color: #16836A;
    color: #FFFFFF;
    border-radius: 5px;
    padding: 8px 18px;
    font-weight: 700;
}
QPushButton#purchasePrimaryButton:hover {
    background-color: #1D9C7F;
}
QPushButton#purchaseSecondaryButton {
    background-color: #252D3E;
    color: #D8E4F8;
    border: 1px solid #3A465D;
    border-radius: 5px;
    padding: 7px 12px;
}
QPushButton#purchaseSecondaryButton:hover {
    background-color: #303A4F;
}
QTableWidget#purchaseInvoiceLines {
    border: 1px solid #354057;
    border-radius: 5px;
    gridline-color: #30394D;
}
QTableWidget#purchaseInvoiceLines QHeaderView::section {
    padding: 8px 6px;
}
QTableWidget#purchaseInvoiceLines QLineEdit,
QTableWidget#purchaseInvoiceLines QComboBox,
QTableWidget#purchaseInvoiceLines QSpinBox,
QTableWidget#purchaseInvoiceLines QDoubleSpinBox,
QTableWidget#purchaseInvoiceLines QDateEdit {
    padding: 3px 5px;
    border-radius: 3px;
}

/* ---------- Sale invoice screens ---------- */
QGroupBox#saleSectionCard {
    background-color: #1B2130;
    color: #E6EDF7;
    border: 1px solid #30394D;
    border-radius: 8px;
    margin-top: 4px;
    padding-top: 2px;
}
QGroupBox#saleSectionCard::title {
    color: #E6EDF7;
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    font-weight: 700;
}
QLabel#saleFormTitle, QLabel#saleListTitle {
    color: #E6EDF7;
    font-size: 13pt;
    font-weight: 700;
}
QLabel#saleFormSubtitle, QLabel#saleFieldCaption {
    color: #A9B4C8;
    font-size: 9pt;
}
QLabel#saleFieldCaption { font-weight: 600; }
QLabel#saleInvoiceNumber, QLabel#saleListCount {
    color: #E6EDF7;
    font-weight: 700;
}
QLabel#saleGrandTotal {
    color: #E6EDF7;
    font-size: 15pt;
    font-weight: 700;
    padding-top: 5px;
}
QLabel#saleDueTotal {
    color: #F2B866;
    font-weight: 700;
}
QLabel#saleOutstandingValue, QLabel#saleModeValue, QLabel#saleLineCount,
QLabel#saleFooterMetric, QLabel#saleListPageTotal {
    color: #E6EDF7;
    font-weight: 700;
}
QPushButton#salePrimaryButton {
    background-color: #187A65;
    color: #FFFFFF;
    border: 1px solid #187A65;
    border-radius: 5px;
    padding: 4px 9px;
    font-weight: 700;
}
QPushButton#salePrimaryButton:hover { background-color: #219779; }
QPushButton#saleSecondaryButton {
    background-color: #232A3B;
    color: #D8E4F8;
    border: 1px solid #3A465D;
    border-radius: 5px;
    padding: 3px 7px;
}
QPushButton#saleSecondaryButton:hover {
    background-color: #303A4F;
}
QTableWidget#saleInvoiceLines, QTableWidget#saleInvoiceListTable {
    background-color: #1B2130;
    color: #E6EDF7;
    border: 1px solid #30394D;
    border-radius: 6px;
    gridline-color: #30394D;
    alternate-background-color: #20263A;
}
QTableWidget#saleInvoiceLines QHeaderView::section,
QTableWidget#saleInvoiceListTable QHeaderView::section {
    background-color: #0A0E16;
    color: #E6EDF7;
    padding: 4px 5px;
    border: none;
    border-bottom: 1px solid #30394D;
    font-weight: 700;
}
QTableWidget#saleInvoiceLines QDoubleSpinBox,
QTableWidget#saleInvoiceLines QComboBox {
    padding: 1px 3px;
    border-radius: 3px;
    font-size: 9pt;
}
QDialog#saleInvoiceFormScreen QLineEdit,
QDialog#saleInvoiceFormScreen QComboBox,
QDialog#saleInvoiceFormScreen QDoubleSpinBox,
QDialog#saleInvoiceFormScreen QDateEdit,
QWidget#saleInvoiceListScreen QLineEdit,
QWidget#saleInvoiceListScreen QComboBox,
QWidget#saleInvoiceListScreen QDateEdit {
    padding: 2px 5px;
    min-height: 20px;
    font-size: 9pt;
}
QDialog#saleInvoiceFormScreen QPushButton,
QWidget#saleInvoiceListScreen QPushButton {
    padding: 3px 7px;
    min-height: 21px;
    font-size: 9pt;
}
QDialog#saleInvoiceFormScreen QCheckBox,
QWidget#saleInvoiceListScreen QCheckBox {
    font-size: 9pt;
}
QTableWidget#saleInvoiceLines QTableCornerButton::section,
QTableWidget#saleInvoiceListTable QTableCornerButton::section {
    background-color: #0A0E16;
    border: none;
}

/* ---------- Lists / Trees / Tables ---------- */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #1B2130;
    color: #E6EDF7;
    border: none;
    border-radius: 0px;
    alternate-background-color: #20263A;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    color: #E6EDF7;
    padding: 5px 6px;
    border-radius: 0px;
}
QTreeWidget::item:hover {
    background-color: #232A3B;
}
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
}
QHeaderView::section {
    background-color: #0A0E16;
    color: #E6EDF7;
    padding: 6px;
    border: none;
    font-weight: 600;
}

/* ---------- ScrollArea / Splitter ---------- */
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: transparent;
    border: 1px solid #2E3648;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    border: 1px solid #3B82F6;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: transparent;
    border: 1px solid #2E3648;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    border: 1px solid #3B82F6;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
QSplitter::handle {
    background-color: #2E3648;
}

/* ---------- Status bar ---------- */
QStatusBar {
    background-color: #0A0E16;
    color: #E6EDF7;
}
QStatusBar QLabel {
    color: #E6EDF7;
}

/* ---------- Menu ---------- */
QMenuBar {
    background-color: #0A0E16;
    color: #E6EDF7;
}
QMenuBar::item {
    background: transparent;
    color: #E6EDF7;
}
QMenuBar::item:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
}
QMenu {
    background-color: #1B2130;
    color: #E6EDF7;
    border: 1px solid #2E3648;
}
QMenu::item:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
}

/* ---------- Feedback labels ---------- */
QLabel#lblLoginMessage {
    color: #FF6B6B;
    font-weight: 600;
}
QLabel#lblCapsLock {
    color: #E0B84D;
    font-weight: 600;
}
QLabel#lblConnectionStatus {
    color: #4ADE80;
    font-weight: 600;
}

/* ---------- Tooltips ---------- */
QToolTip {
    background-color: #0A0E16;
    color: #E6EDF7;
    border: 1px solid #3B82F6;
    padding: 4px 8px;
    border-radius: 4px;
}
/* ---------- Dashboard sidebar tree: bigger, bold ---------- */
QTreeWidget#treeSidebarMenu {
    font-size: 11.5pt;
}
QTreeWidget#treeSidebarMenu::item {
    padding: 7px 6px;
}
/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: 1px solid #2E3648;
    background-color: #12161F;
}
QTabBar::tab {
    background-color: #1B2130;
    color: #E6EDF7;
    padding: 6px 14px;
    border: 1px solid #2E3648;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #20263A;
    color: #FFFFFF;
    border-bottom: 2px solid #3B82F6;
}
QTabBar::tab:hover:!selected {
    background-color: #20263A;
    color: #E6EDF7;
}
QTabBar::tab:disabled {
    background-color: #2E3648;
    color: #6B7690;
}