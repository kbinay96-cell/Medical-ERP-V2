/* =========================================================
   Medical ERP V2 - BLACK THEME (Firefox-inspired palette)
   ---------------------------------------------------------
   Near-black background, soft violet/purple accent, subtle
   rounded cards. Third theme alongside Light and Dark(Blue).
   Same rule as the other themes: every background pairs with
   an explicit foreground - nothing inherits from the OS
   palette.
   ========================================================= */

* {
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10.5pt;
    color: #E8E8ED;
}

QMainWindow, QDialog, QWidget {
    background-color: #1A1A22;
    color: #E8E8ED;
}

/* ---------- Brand header / footer bars ---------- */
QFrame#frmHeader, QFrame#frmTopHeader, QFrame#frmFooter {
    background-color: #0F0F14;
    color: #E8E8ED;
}
QFrame#frmHeader QLabel, QFrame#frmTopHeader QLabel, QFrame#frmFooter QLabel {
    color: #E8E8ED;
    background: transparent;
}

/* ---------- Left branding panel (Login) ---------- */
QFrame#frmLeftPanel {
    background-color: #201F29;
    color: #C7C7D6;
}
QFrame#frmLeftPanel QLabel {
    color: #C7C7D6;
    background: transparent;
}
QLabel#lblWelcomeMessage {
    color: #FFFFFF;
    font-size: 16pt;
    font-weight: 700;
}
QLabel#lblTagline {
    color: #9B8CD6;
    font-style: italic;
}

/* ---------- Login card / Sidebar / cards (dark surfaces) ---------- */
QFrame#frmLoginPanel, QFrame#frmSidebar, QFrame#loginCard {
    background-color: #26252F;
    color: #E8E8ED;
    border-radius: 12px;
    border: 1px solid #35333F;
}
QFrame#frmLoginPanel QLabel, QFrame#frmSidebar QLabel, QFrame#loginCard QLabel {
    color: #E8E8ED;
    background: transparent;
}

QLabel {
    color: #E8E8ED;
    background: transparent;
}

/* ---------- Buttons (violet accent, like the reference) ---------- */
QPushButton {
    background-color: #7C4DFF;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    padding: 6px 14px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #9370FF;
    color: #FFFFFF;
}
QPushButton:pressed {
    background-color: #6236D9;
    color: #FFFFFF;
}
QPushButton:disabled {
    background-color: #35333F;
    color: #6E6C7A;
}

QPushButton[flat="true"] {
    background-color: transparent;
    color: #B49AFF;
    text-decoration: underline;
    padding: 4px 6px;
}
QPushButton[flat="true"]:hover {
    color: #D0BFFF;
    background-color: transparent;
}

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QSpinBox, QDateEdit {
    padding: 5px 7px;
    border: 1px solid #35333F;
    border-radius: 2px;
    background-color: #201F29;
    color: #E8E8ED;
    selection-background-color: #7C4DFF;
    selection-color: #FFFFFF;
}
/* ---------- BS Date Field + Calendar Popup ---------- */
QLineEdit[cssClass="dateFieldInput"] {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
}
QToolButton[cssClass="dateFieldButton"] {
    border: 1px solid #35333F;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-radius: 2px;
    background-color: #201F29;
    padding: 4px;
}
QToolButton[cssClass="dateFieldButton"]:hover {
    background-color: #2A2833;
}

QDialog[cssClass="bsCalendarPopup"] {
    background-color: #1A1922;
    border: 1px solid #35333F;
    border-radius: 6px;
}
QToolButton[cssClass="bsCalendarNavButton"] {
    border: none;
    border-radius: 4px;
    background-color: transparent;
    color: #E8E8ED;
    font-weight: bold;
    padding: 4px 8px;
}
QToolButton[cssClass="bsCalendarNavButton"]:hover {
    background-color: #2A2833;
}
QComboBox[cssClass="bsCalendarDropdown"] {
    font-weight: bold;
    color: #E8E8ED;
    background-color: #17161C;
    border: 1px solid #35333F;
    border-radius: 4px;
    padding: 2px 5px;
}
QLabel[cssClass="bsCalendarWeekdayLabel"] {
    font-weight: bold;
    font-size: 9pt;
    color: #9A96AC;
    padding: 4px 0;
}
QPushButton[cssClass="bsCalendarDayButton"] {
    border: 1px solid #35333F;
    border-radius: 4px;
    background-color: transparent;
    color: #E8E8ED;
    font-size: 8pt;
    font-weight: bold;
    padding: 0;
    margin: 0;
    min-width: 0;
}
QPushButton[cssClass="bsCalendarDayButton"]:hover {
    background-color: #2A2833;
}
QPushButton[cssClass="bsCalendarDayButton"][dayState="today"] {
    border: 1px solid #7C4DFF;
    color: #7C4DFF;
    font-weight: bold;
}
QPushButton[cssClass="bsCalendarDayButton"][dayState="selected"] {
    background-color: #7C4DFF;
    color: #FFFFFF;
    font-weight: bold;
}
QPushButton[cssClass="bsCalendarDayButton"][dayState="holiday"] {
    color: #E06C6C;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #7C4DFF;
}
QLineEdit::placeholder {
    color: #7A7887;
}
QComboBox QAbstractItemView {
    background-color: #26252F;
    color: #E8E8ED;
    border: 1px solid #35333F;
    selection-background-color: #7C4DFF;
    selection-color: #FFFFFF;
}

/* ---------- Checkboxes / Radio ---------- */
QCheckBox, QRadioButton {
    color: #E8E8ED;
    background: transparent;
    spacing: 6px;
}

/* ---------- Group boxes ---------- */
QGroupBox {
    color: #E8E8ED;
    font-weight: 600;
    border: none;
    border-top: 1px solid #35333F;
    border-radius: 0px;
    margin-top: 8px;
    padding-top: 10px;
    background-color: transparent;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #E8E8ED;
    background-color: #201F29;
}

/* ---------- KPI cards / setting cards ---------- */
QFrame[cssClass="kpiCard"] {
    background-color: #26252F;
    border: 1px solid #35333F;
    border-radius: 12px;
}
QFrame[cssClass="kpiCard"] QLabel[cssClass="kpiTitle"] {
    color: #A9A7B8;
    font-weight: 600;
    font-size: 9.5pt;
}
QFrame[cssClass="kpiCard"] QLabel[cssClass="kpiValue"] {
    color: #FFFFFF;
    font-weight: 700;
    font-size: 16pt;
}

/* ---------- Dashboard home ---------- */
QFrame#dashboardWelcomeCard {
    background-color: #2A2737;
    border: 1px solid #403B51;
    border-radius: 10px;
}
QLabel#dashboardGreeting {
    background: transparent;
    color: #FFFFFF;
    font-size: 18pt;
    font-weight: 700;
}
QLabel#dashboardDate {
    background: transparent;
    color: #B9B5C9;
    font-size: 9.5pt;
}
QPushButton#dashboardRefreshButton {
    background-color: #332F43;
    color: #F0EDF8;
    border: 1px solid #514B65;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton#dashboardRefreshButton:hover { background-color: #403A55; }
QGroupBox#grpKpiCards, QGroupBox#grpQuickActions, QGroupBox#grpActivityArea {
    border: none;
    margin-top: 12px;
    padding: 0;
}
QGroupBox#grpKpiCards::title, QGroupBox#grpQuickActions::title,
QGroupBox#grpActivityArea::title {
    left: 0;
    padding: 0 0 8px 0;
    background: transparent;
    color: #F0EDF8;
    font-size: 12pt;
    font-weight: 700;
}
QFrame[cssClass="dashboardMetricCard"] {
    background-color: #26252F;
    border: 1px solid #35333F;
    border-left: 4px solid #9B87F5;
    border-radius: 8px;
}
QFrame[cssClass="dashboardMetricCard"][metricTone="purchase"] { border-left-color: #B69CFF; }
QFrame[cssClass="dashboardMetricCard"][metricTone="stock"] { border-left-color: #42C59A; }
QFrame[cssClass="dashboardMetricCard"][metricTone="warning"] { border-left-color: #F0B648; }
QFrame[cssClass="dashboardMetricCard"][metricTone="expiry"] { border-left-color: #F0788A; }
QFrame[cssClass="dashboardMetricCard"][metricTone="payments"] { border-left-color: #E99A39; }
QFrame[cssClass="dashboardMetricCard"][metricTone="receipts"] { border-left-color: #44C3D6; }
QFrame[cssClass="dashboardMetricCard"][metricTone="users"] { border-left-color: #A9A7B8; }
QLabel[cssClass="dashboardMetricTitle"] {
    color: #A9A7B8;
    font-size: 9pt;
    font-weight: 600;
}
QLabel[cssClass="dashboardMetricValue"] {
    color: #F0EDF8;
    font-size: 17pt;
    font-weight: 700;
}
QPushButton[cssClass="dashboardActionButton"] {
    background-color: #2C2A36;
    color: #E8E6F0;
    border: 1px solid #403D4A;
    border-radius: 6px;
    padding: 8px 12px;
    text-align: left;
    font-weight: 600;
}
QPushButton[cssClass="dashboardActionButton"]:hover {
    background-color: #373442;
    border-color: #625B72;
}
QPushButton[cssClass="dashboardActionButton"][actionTone="primary"] {
    background-color: #7049E8;
    color: #FFFFFF;
    border-color: #7049E8;
}
QPushButton[cssClass="dashboardActionButton"][actionTone="primary"]:hover { background-color: #845FF5; }
QPushButton[cssClass="dashboardActionButton"][actionTone="purchase"] {
    background-color: #16836A;
    color: #FFFFFF;
    border-color: #16836A;
}
QPushButton[cssClass="dashboardActionButton"][actionTone="purchase"]:hover { background-color: #1D9C7F; }
QPushButton[cssClass="dashboardActionButton"][actionTone="quiet"] {
    background-color: #302D3A;
    color: #E8E6F0;
}
QGroupBox#grpAlerts, QGroupBox#grpRecentActivity,
QGroupBox#grpFavorites, QGroupBox#grpRecentlyOpened {
    background-color: #26252F;
    border: 1px solid #35333F;
    border-radius: 8px;
    margin-top: 8px;
    padding: 14px 10px 10px 10px;
}
QGroupBox#grpAlerts::title, QGroupBox#grpRecentActivity::title,
QGroupBox#grpFavorites::title, QGroupBox#grpRecentlyOpened::title {
    left: 12px;
    padding: 0 5px;
    background-color: #26252F;
    color: #E8E6F0;
    font-size: 10pt;
    font-weight: 700;
}
QCalendarWidget#purchaseInvoiceCalendar {
    background-color: #26252F;
    color: #E8E8ED;
    border: 1px solid #403D4A;
    border-radius: 6px;
    min-width: 248px;
    max-width: 248px;
    min-height: 210px;
    max-height: 210px;
}
QWidget#purchaseCalendarNavigation {
    background-color: #302D3A;
}
QToolButton#purchaseCalendarNavigationButton {
    background-color: #373442;
    color: #E8E6F0;
    border: 1px solid #514B65;
    border-radius: 4px;
    min-width: 14px;
    min-height: 22px;
    padding: 0;
    font-weight: 700;
}
QToolButton#purchaseCalendarNavigationButton:hover {
    background-color: #494458;
}
QComboBox#purchaseCalendarMonth, QComboBox#purchaseCalendarYear {
    background-color: #302D3A;
    color: #E8E8ED;
    border: 1px solid #514B65;
    border-radius: 4px;
    min-height: 24px;
    padding: 1px 12px 1px 3px;
    font-size: 9pt;
}
QComboBox#purchaseCalendarMonth::drop-down, QComboBox#purchaseCalendarYear::drop-down {
    border: none;
    width: 10px;
}
QComboBox#purchaseCalendarMonth::down-arrow, QComboBox#purchaseCalendarYear::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #B9B5C9;
}
QCalendarWidget#purchaseInvoiceCalendar QAbstractItemView {
    background-color: #26252F;
    color: #E8E8ED;
    selection-background-color: #7049E8;
    selection-color: #FFFFFF;
    outline: 0;
}
QCalendarWidget#purchaseInvoiceCalendar QAbstractItemView:enabled {
    alternate-background-color: #302D3A;
}
QCalendarWidget#purchaseInvoiceCalendar QAbstractItemView::item {
    padding: 1px;
}
QListWidget#dashboardAlerts, QListWidget#dashboardActivityList,
QListWidget#dashboardFavoritesList, QListWidget#dashboardRecentlyOpenedList {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget#dashboardAlerts::item, QListWidget#dashboardActivityList::item,
QListWidget#dashboardFavoritesList::item, QListWidget#dashboardRecentlyOpenedList::item {
    padding: 8px;
    border-bottom: 1px solid #383541;
}
QListWidget#dashboardAlerts::item:selected, QListWidget#dashboardActivityList::item:selected,
QListWidget#dashboardFavoritesList::item:selected, QListWidget#dashboardRecentlyOpenedList::item:selected {
    background-color: #373442;
    color: #F0EDF8;
}

/* ---------- Sale invoice screens ---------- */
QGroupBox#saleSectionCard {
    background-color: #201F29;
    color: #E8E8ED;
    border: 1px solid #35333F;
    border-radius: 8px;
    margin-top: 4px;
    padding-top: 2px;
}
QGroupBox#saleSectionCard::title {
    color: #E8E8ED;
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    font-weight: 700;
}
QLabel#saleFormTitle, QLabel#saleListTitle {
    color: #E8E8ED;
    font-size: 13pt;
    font-weight: 700;
}
QLabel#saleFormSubtitle, QLabel#saleFieldCaption {
    color: #B7B4C4;
    font-size: 9pt;
}
QLabel#saleFieldCaption { font-weight: 600; }
QLabel#saleInvoiceNumber, QLabel#saleListCount {
    color: #E8E8ED;
    font-weight: 700;
}
QLabel#saleGrandTotal {
    color: #E8E8ED;
    font-size: 15pt;
    font-weight: 700;
    padding-top: 5px;
}
QLabel#saleDueTotal { color: #E8B7A2; font-weight: 700; }
QLabel#saleOutstandingValue, QLabel#saleModeValue, QLabel#saleLineCount,
QLabel#saleFooterMetric, QLabel#saleListPageTotal {
    color: #E8E8ED;
    font-weight: 700;
}
QPushButton#salePrimaryButton {
    background-color: #6841C8;
    color: #FFFFFF;
    border: 1px solid #6841C8;
    border-radius: 5px;
    padding: 2px 6px;
    font-weight: 700;
}
QPushButton#salePrimaryButton:hover { background-color: #7C4DFF; }
QPushButton#saleSecondaryButton {
    background-color: #292833;
    color: #E0DDF0;
    border: 1px solid #454250;
    border-radius: 5px;
    padding: 2px 6px;
}
QPushButton#saleSecondaryButton:hover {
    background-color: #373442;
}
QTableWidget#saleInvoiceLines, QTableWidget#saleInvoiceListTable {
    background-color: #201F29;
    color: #E8E8ED;
    border: 1px solid #35333F;
    border-radius: 6px;
    gridline-color: #35333F;
    alternate-background-color: #26252F;
}
QTableWidget#saleInvoiceLines QHeaderView::section,
QTableWidget#saleInvoiceListTable QHeaderView::section {
    background-color: #0F0F14;
    color: #E8E8ED;
    padding: 0px 6px;
    border: none;
    border-bottom: 1px solid #35333F;
    font-weight: 700;
}
QTableWidget#saleInvoiceLines QDoubleSpinBox,
QTableWidget#saleInvoiceLines QComboBox {
    padding: 1px 3px;
    border-radius: 3px;
    font-size: 9pt;
}
QDialog#saleInvoiceFormScreen QLineEdit,
QDialog#saleInvoiceFormScreen QComboBox,
QDialog#saleInvoiceFormScreen QDoubleSpinBox,
QDialog#saleInvoiceFormScreen QDateEdit,
QWidget#saleInvoiceListScreen QLineEdit,
QWidget#saleInvoiceListScreen QComboBox,
QWidget#saleInvoiceListScreen QDateEdit {
    padding: 2px 5px;
    min-height: 20px;
    font-size: 9pt;
}
QDialog#saleInvoiceFormScreen QPushButton,
QWidget#saleInvoiceListScreen QPushButton {
    padding: 3px 7px;
    min-height: 21px;
    font-size: 9pt;
}
QDialog#saleInvoiceFormScreen QCheckBox,
QWidget#saleInvoiceListScreen QCheckBox {
    font-size: 9pt;
}
QTableWidget#saleInvoiceLines QTableCornerButton::section,
QTableWidget#saleInvoiceListTable QTableCornerButton::section {
    background-color: #0F0F14;
    border: none;
}

/* ---------- Lists / Trees / Tables ---------- */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #201F29;
    color: #E8E8ED;
    border: none;
    border-radius: 0px;
    alternate-background-color: #26252F;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    color: #E8E8ED;
    padding: 5px 6px;
    border-radius: 0px;
}
QTreeWidget::item:hover {
    background-color: #26252F;
}
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background-color: #7C4DFF;
    color: #FFFFFF;
}
QHeaderView::section {
    background-color: #0F0F14;
    color: #E8E8ED;
    padding: 6px;
    border: none;
    font-weight: 600;
}

/* ---------- ScrollArea / Splitter ---------- */
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: transparent;
    border: 1px solid #35333F;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    border: 1px solid #7C4DFF;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: transparent;
    border: 1px solid #35333F;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    border: 1px solid #7C4DFF;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
QSplitter::handle {
    background-color: #35333F;
}

/* ---------- Status bar ---------- */
QStatusBar {
    background-color: #0F0F14;
    color: #E8E8ED;
}
QStatusBar QLabel {
    color: #E8E8ED;
}

/* ---------- Menu ---------- */
QMenuBar {
    background-color: #0F0F14;
    color: #E8E8ED;
}
QMenuBar::item {
    background: transparent;
    color: #E8E8ED;
}
QMenuBar::item:selected {
    background-color: #7C4DFF;
    color: #FFFFFF;
}
QMenu {
    background-color: #26252F;
    color: #E8E8ED;
    border: 1px solid #35333F;
}
QMenu::item:selected {
    background-color: #7C4DFF;
    color: #FFFFFF;
}

/* ---------- Feedback labels ---------- */
QLabel#lblLoginMessage {
    color: #FF7B9C;
    font-weight: 600;
}
QLabel#lblCapsLock {
    color: #E0B84D;
    font-weight: 600;
}
QLabel#lblConnectionStatus {
    color: #5FDD9D;
    font-weight: 600;
}

/* ---------- Tooltips ---------- */
QToolTip {
    background-color: #0F0F14;
    color: #E8E8ED;
    border: 1px solid #7C4DFF;
    padding: 4px 8px;
    border-radius: 6px;
}

/* =========================================================
   SETTINGS SCREEN (Black theme)
   ---------------------------------------------------------
   Hook names kept identical to the Blue dark theme
   (settingRow/settingLabel/settingDescription) so both
   themes style the same settings.ui structure consistently.
   ========================================================= */

/* ---------- Settings module: dynamic setting rows ---------- */
QFrame[cssClass="settingRow"] {
    background-color: #201F29;
    border: 1px solid #2C2A36;
    border-radius: 10px;
}
QFrame[cssClass="settingRow"]:hover {
    border: 1px solid #7C4DFF;
}
QLabel[cssClass="settingLabel"] {
    color: #FFFFFF;
    font-weight: 600;
}
QLabel[cssClass="settingDescription"] {
    color: #9391A0;
    font-size: 9pt;
}

/* ---------- Settings module: header search box ---------- */
QFrame[cssClass="searchBox"] {
    background-color: #26252F;
    border: 1px solid #35333F;
    border-radius: 8px;
}
QFrame[cssClass="searchBox"] QLineEdit {
    background: transparent;
    border: none;
    padding: 0px;
}

/* ---------- Settings module: primary Save button ---------- */
QPushButton[cssClass="primaryButton"] {
    background-color: #7C4DFF;
    color: #FFFFFF;
}
QPushButton[cssClass="primaryButton"]:hover {
    background-color: #9370FF;
}
QPushButton[cssClass="primaryButton"]:pressed {
    background-color: #6236D9;
}

/* ---------- Settings module: unsaved-changes indicator ---------- */
QLabel[cssClass="unsavedIndicator"] {
    color: #E0B84D;
    font-weight: 600;
}
/* ---------- Dashboard sidebar tree: bigger, bold ---------- */
QTreeWidget#treeSidebarMenu {
    font-size: 11.5pt;
}
QTreeWidget#treeSidebarMenu::item {
    padding: 7px 6px;
}
/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: 1px solid #35333F;
    background-color: #1A1A22;
}
QTabBar::tab {
    background-color: #201F29;
    color: #E8E8ED;
    padding: 6px 14px;
    border: 1px solid #35333F;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #26252F;
    color: #FFFFFF;
    border-bottom: 2px solid #7C4DFF;
}
QTabBar::tab:hover:!selected {
    background-color: #26252F;
    color: #E8E8ED;
}
QTabBar::tab:disabled {
    background-color: #35333F;
    color: #6E6C7A;
}