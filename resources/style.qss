/* =========================================================
   Medical ERP V2 - LIGHT THEME
   ---------------------------------------------------------
   Rule followed throughout: every selector that sets a
   background ALSO sets a matching foreground, and vice
   versa. Nothing is left to inherit from the OS palette -
   that inheritance is exactly what caused the white-on-white
   bug. This file is the single source of truth for Light
   mode across the WHOLE application (Login, Dashboard, and
   every future module screen), since every screen shares
   these same base widget classes.
   ========================================================= */

* {
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10.5pt;
    color: #1B2430;
}

QMainWindow, QDialog, QWidget {
    background-color: #F4F6F9;
    color: #1B2430;
}

/* ---------- Brand header / footer bars ---------- */
QFrame#frmHeader, QFrame#frmTopHeader, QFrame#frmFooter {
    background-color: #1F2A44;
    color: #FFFFFF;
}
QFrame#frmHeader QLabel, QFrame#frmTopHeader QLabel, QFrame#frmFooter QLabel {
    color: #FFFFFF;
    background: transparent;
}

/* ---------- Left branding panel (Login) ---------- */
QFrame#frmLeftPanel {
    background-color: #24304D;
    color: #E6EDF7;
}
QFrame#frmLeftPanel QLabel {
    color: #E6EDF7;
    background: transparent;
}
QLabel#lblWelcomeMessage {
    color: #FFFFFF;
    font-size: 16pt;
    font-weight: 700;
}
QLabel#lblTagline {
    color: #9FB3D1;
    font-style: italic;
}

/* ---------- Login card / Sidebar (light surfaces) ---------- */
QFrame#frmLoginPanel, QFrame#frmSidebar, QFrame#loginCard {
    background-color: #FFFFFF;
    color: #1B2430;
    border-radius: 10px;
}
QFrame#frmLoginPanel QLabel, QFrame#frmSidebar QLabel, QFrame#loginCard QLabel {
    color: #1B2430;
    background: transparent;
}

/* ---------- Generic labels everywhere else ---------- */
QLabel {
    color: #1B2430;
    background: transparent;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #2F6FED;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    padding: 6px 14px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #4A85FF;
    color: #FFFFFF;
}
QPushButton:pressed {
    background-color: #1E52C4;
    color: #FFFFFF;
}
QPushButton:disabled {
    background-color: #C6CDDA;
    color: #8A93A3;
}

QPushButton[flat="true"] {
    background-color: transparent;
    color: #2F6FED;
    text-decoration: underline;
    padding: 4px 6px;
}
QPushButton[flat="true"]:hover {
    color: #1E52C4;
    background-color: transparent;
}

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QSpinBox, QDateEdit {
    padding: 5px 7px;
    border: 1px solid #C7CEDA;
    border-radius: 2px;
    background-color: #FFFFFF;
    color: #1B2430;
    selection-background-color: #2F6FED;
    selection-color: #FFFFFF;
}
/* ---------- BS Date Field + Calendar Popup ---------- */
QLineEdit[cssClass="dateFieldInput"] {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
}
QToolButton[cssClass="dateFieldButton"] {
    border: 1px solid #C7CEDA;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-radius: 2px;
    background-color: #FFFFFF;
    padding: 4px;
}
QToolButton[cssClass="dateFieldButton"]:hover {
    background-color: #EEF3FC;
}

QDialog[cssClass="bsCalendarPopup"] {
    background-color: #FFFFFF;
    border: 1px solid #C7CEDA;
    border-radius: 6px;
}
QToolButton[cssClass="bsCalendarNavButton"] {
    border: none;
    border-radius: 4px;
    background-color: transparent;
    color: #1B2430;
    font-weight: bold;
    padding: 4px 8px;
}
QToolButton[cssClass="bsCalendarNavButton"]:hover {
    background-color: #EEF3FC;
}
QComboBox[cssClass="bsCalendarDropdown"] {
    font-weight: bold;
    color: #1B2430;
    background-color: #FFFFFF;
    border: 1px solid #C7CEDA;
    border-radius: 4px;
    padding: 2px 5px;
}
QLabel[cssClass="bsCalendarWeekdayLabel"] {
    font-weight: bold;
    font-size: 9pt;
    color: #6B7686;
    padding: 4px 0;
}
QPushButton[cssClass="bsCalendarDayButton"] {
    border: 1px solid #E1E6EE;
    border-radius: 4px;
    background-color: transparent;
    color: #1B2430;
    font-size: 8pt;
    font-weight: bold;
    padding: 0;
    margin: 0;
    min-width: 0;
}
QPushButton[cssClass="bsCalendarDayButton"]:hover {
    background-color: #EEF3FC;
}
QPushButton[cssClass="bsCalendarDayButton"][dayState="today"] {
    border: 1px solid #2F6FED;
    color: #2F6FED;
    font-weight: bold;
}
QPushButton[cssClass="bsCalendarDayButton"][dayState="selected"] {
    background-color: #2F6FED;
    color: #FFFFFF;
    font-weight: bold;
}
QPushButton[cssClass="bsCalendarDayButton"][dayState="holiday"] {
    color: #C0392B;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #2F6FED;
}
QLineEdit::placeholder {
    color: #8A93A3;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1B2430;
    border: 1px solid #C7CEDA;
    selection-background-color: #2F6FED;
    selection-color: #FFFFFF;
}

/* ---------- Checkboxes / Radio ---------- */
QCheckBox, QRadioButton {
    color: #1B2430;
    background: transparent;
    spacing: 6px;
}

/* ---------- Group boxes ---------- */
QGroupBox {
    color: #1B2430;
    font-weight: 600;
    border: none;
    border-top: 1px solid #E2E6ED;
    border-radius: 0px;
    margin-top: 8px;
    padding-top: 10px;
    background-color: transparent;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #1B2430;
    background-color: #FFFFFF;
}

/* ---------- KPI cards ---------- */
QFrame[cssClass="kpiCard"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E6ED;
    border-radius: 10px;
}
QFrame[cssClass="kpiCard"] QLabel[cssClass="kpiTitle"] {
    color: #5B6472;
    font-weight: 600;
    font-size: 9.5pt;
}
QFrame[cssClass="kpiCard"] QLabel[cssClass="kpiValue"] {
    color: #1F2A44;
    font-weight: 700;
    font-size: 16pt;
}

/* ---------- Dashboard home ---------- */
QFrame#dashboardWelcomeCard {
    background-color: #1F2A44;
    border-radius: 10px;
}
QLabel#dashboardGreeting {
    background: transparent;
    color: #FFFFFF;
    font-size: 18pt;
    font-weight: 700;
}
QLabel#dashboardDate {
    background: transparent;
    color: #C7D4EA;
    font-size: 9.5pt;
}
QPushButton#dashboardRefreshButton {
    background-color: #FFFFFF;
    color: #1F2A44;
    border: 1px solid #D6DEEA;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton#dashboardRefreshButton:hover {
    background-color: #EEF3FC;
}
QGroupBox#grpKpiCards, QGroupBox#grpQuickActions, QGroupBox#grpActivityArea {
    border: none;
    margin-top: 12px;
    padding: 0;
}
QGroupBox#grpKpiCards::title, QGroupBox#grpQuickActions::title,
QGroupBox#grpActivityArea::title {
    left: 0;
    padding: 0 0 8px 0;
    background: transparent;
    color: #1F2A44;
    font-size: 12pt;
    font-weight: 700;
}
QFrame[cssClass="dashboardMetricCard"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E6ED;
    border-left: 4px solid #2F6FED;
    border-radius: 8px;
}
QFrame[cssClass="dashboardMetricCard"][metricTone="purchase"] { border-left-color: #8B5CF6; }
QFrame[cssClass="dashboardMetricCard"][metricTone="stock"] { border-left-color: #0E9F6E; }
QFrame[cssClass="dashboardMetricCard"][metricTone="warning"] { border-left-color: #E09A24; }
QFrame[cssClass="dashboardMetricCard"][metricTone="expiry"] { border-left-color: #E05A67; }
QFrame[cssClass="dashboardMetricCard"][metricTone="payments"] { border-left-color: #D97706; }
QFrame[cssClass="dashboardMetricCard"][metricTone="receipts"] { border-left-color: #0891B2; }
QFrame[cssClass="dashboardMetricCard"][metricTone="users"] { border-left-color: #64748B; }
QLabel[cssClass="dashboardMetricTitle"] {
    color: #667085;
    font-size: 9pt;
    font-weight: 600;
}
QLabel[cssClass="dashboardMetricValue"] {
    color: #1F2A44;
    font-size: 17pt;
    font-weight: 700;
}
QPushButton[cssClass="dashboardActionButton"] {
    background-color: #FFFFFF;
    color: #344054;
    border: 1px solid #E2E6ED;
    border-radius: 6px;
    padding: 8px 12px;
    text-align: left;
    font-weight: 600;
}
QPushButton[cssClass="dashboardActionButton"]:hover {
    background-color: #F7F9FC;
    border-color: #B9C9E2;
}
QPushButton[cssClass="dashboardActionButton"][actionTone="primary"] {
    background-color: #2F6FED;
    color: #FFFFFF;
    border-color: #2F6FED;
}
QPushButton[cssClass="dashboardActionButton"][actionTone="primary"]:hover {
    background-color: #1E52C4;
}
QPushButton[cssClass="dashboardActionButton"][actionTone="purchase"] {
    background-color: #1F6F5C;
    color: #FFFFFF;
    border-color: #1F6F5C;
}
QPushButton[cssClass="dashboardActionButton"][actionTone="purchase"]:hover {
    background-color: #185B4B;
}
QPushButton[cssClass="dashboardActionButton"][actionTone="quiet"] {
    background-color: #EEF3FC;
    color: #344054;
}
QGroupBox#grpAlerts, QGroupBox#grpRecentActivity,
QGroupBox#grpFavorites, QGroupBox#grpRecentlyOpened {
    background-color: #FFFFFF;
    border: 1px solid #E2E6ED;
    border-radius: 8px;
    margin-top: 8px;
    padding: 14px 10px 10px 10px;
}
QGroupBox#grpAlerts::title, QGroupBox#grpRecentActivity::title,
QGroupBox#grpFavorites::title, QGroupBox#grpRecentlyOpened::title {
    left: 12px;
    padding: 0 5px;
    background-color: #FFFFFF;
    color: #1F2A44;
    font-size: 10pt;
    font-weight: 700;
}
QCalendarWidget#purchaseInvoiceCalendar {
    background-color: #FFFFFF;
    color: #1B2430;
    border: 1px solid #D8DEE8;
    border-radius: 6px;
    min-width: 248px;
    max-width: 248px;
    min-height: 210px;
    max-height: 210px;
}
QWidget#purchaseCalendarNavigation {
    background-color: #F4F6F9;
}
QToolButton#purchaseCalendarNavigationButton {
    background-color: #EEF3FC;
    color: #244B8F;
    border: 1px solid #D8E2F3;
    border-radius: 4px;
    min-width: 14px;
    min-height: 22px;
    padding: 0;
    font-weight: 700;
}
QToolButton#purchaseCalendarNavigationButton:hover {
    background-color: #DCE8FA;
}
QComboBox#purchaseCalendarMonth, QComboBox#purchaseCalendarYear {
    background-color: #FFFFFF;
    color: #1B2430;
    border: 1px solid #C7CEDA;
    border-radius: 4px;
    min-height: 24px;
    padding: 1px 12px 1px 3px;
    font-size: 9pt;
}
QComboBox#purchaseCalendarMonth::drop-down, QComboBox#purchaseCalendarYear::drop-down {
    border: none;
    width: 10px;
}
QComboBox#purchaseCalendarMonth::down-arrow, QComboBox#purchaseCalendarYear::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #52627A;
}
QCalendarWidget#purchaseInvoiceCalendar QAbstractItemView {
    background-color: #FFFFFF;
    color: #1B2430;
    selection-background-color: #2F6FED;
    selection-color: #FFFFFF;
    outline: 0;
}
QCalendarWidget#purchaseInvoiceCalendar QAbstractItemView:enabled {
    alternate-background-color: #F7F9FC;
}
QCalendarWidget#purchaseInvoiceCalendar QAbstractItemView::item {
    padding: 1px;
}
QListWidget#dashboardAlerts, QListWidget#dashboardActivityList,
QListWidget#dashboardFavoritesList, QListWidget#dashboardRecentlyOpenedList {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget#dashboardAlerts::item, QListWidget#dashboardActivityList::item,
QListWidget#dashboardFavoritesList::item, QListWidget#dashboardRecentlyOpenedList::item {
    padding: 8px;
    border-bottom: 1px solid #EEF1F5;
}
QListWidget#dashboardAlerts::item:selected, QListWidget#dashboardActivityList::item:selected,
QListWidget#dashboardFavoritesList::item:selected, QListWidget#dashboardRecentlyOpenedList::item:selected {
    background-color: #EEF3FC;
    color: #1F2A44;
}

/* ---------- Purchase invoice entry ---------- */
QFrame#purchaseInvoiceCard {
    background-color: #FFFFFF;
    color: #1B2430;
    border: 1px solid #E2E6ED;
    border-radius: 8px;
}
QFrame#purchaseInvoiceCard QLabel, QWidget#purchaseInvoiceContent {
    background: transparent;
}
QLabel#purchaseFormTitle {
    color: #1F2A44;
    font-size: 18pt;
    font-weight: 700;
}
QLabel#purchaseSectionTitle {
    color: #1F2A44;
    font-size: 11.5pt;
    font-weight: 700;
}
QLabel#purchaseSectionDescription, QLabel#purchaseAttachmentStatus, QLabel#purchaseRoundOff {
    color: #687386;
    font-size: 9pt;
}
QLabel#purchaseAttachmentStatus[attachmentState="attached"] {
    color: #1F6F5C;
    font-weight: 600;
}
QLabel#purchaseLineCount {
    color: #1F2A44;
    font-weight: 700;
}
QLabel#purchaseGrandTotal {
    color: #1F2A44;
    font-size: 20pt;
    font-weight: 700;
}
QLabel#purchaseFooterTotal {
    color: #1F2A44;
    font-size: 12pt;
    font-weight: 700;
}
QPushButton#purchasePrimaryButton {
    background-color: #1F6F5C;
    color: #FFFFFF;
    border-radius: 5px;
    padding: 2px 6px;
    font-weight: 700;
}
QPushButton#purchasePrimaryButton:hover {
    background-color: #27866E;
}
QPushButton#purchaseSecondaryButton {
    background-color: #EEF3FC;
    color: #244B8F;
    border: 1px solid #D8E2F3;
    border-radius: 5px;
    padding: 2px 6px;
}
QPushButton#purchaseSecondaryButton:hover {
    background-color: #E2EBFB;
}
QTableWidget#purchaseInvoiceLines {
    border: 1px solid #E2E6ED;
    border-radius: 5px;
    gridline-color: #E8ECF2;
}
QTableWidget#purchaseInvoiceLines QHeaderView::section {
    padding: 0px 6px;
}
QTableWidget#purchaseInvoiceLines QLineEdit,
QTableWidget#purchaseInvoiceLines QComboBox,
QTableWidget#purchaseInvoiceLines QSpinBox,
QTableWidget#purchaseInvoiceLines QDoubleSpinBox,
QTableWidget#purchaseInvoiceLines QDateEdit {
    padding: 0px 6px;
    border-radius: 3px;
}

/* ---------- Sale invoice screens ---------- */
QGroupBox#saleSectionCard {
    background-color: #FFFFFF;
    color: #1B2430;
    border: 1px solid #E2E6ED;
    border-radius: 8px;
    margin-top: 4px;
    padding-top: 2px;
}
QGroupBox#saleSectionCard::title {
    color: #1F2A44;
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    font-weight: 700;
}
QLabel#saleFormTitle, QLabel#saleListTitle {
    color: #1F2A44;
    font-size: 13pt;
    font-weight: 700;
}
QLabel#saleFormSubtitle, QLabel#saleFieldCaption {
    color: #667085;
    font-size: 9pt;
}
QLabel#saleFieldCaption { font-weight: 600; }
QLabel#saleInvoiceNumber, QLabel#saleListCount {
    color: #1F2A44;
    font-weight: 700;
}
QLabel#saleGrandTotal {
    color: #1F2A44;
    font-size: 15pt;
    font-weight: 700;
    padding-top: 5px;
}
QLabel#saleDueTotal {
    color: #B54708;
    font-weight: 700;
}
QLabel#saleOutstandingValue, QLabel#saleModeValue, QLabel#saleLineCount,
QLabel#saleFooterMetric, QLabel#saleListPageTotal {
    color: #1F2A44;
    font-weight: 700;
}
QPushButton#salePrimaryButton {
    background-color: #1F6F5C;
    color: #FFFFFF;
    border: 1px solid #1F6F5C;
    border-radius: 5px;
    padding: 2px 6px;
    font-weight: 700;
}
QPushButton#salePrimaryButton:hover { background-color: #27866E; }
QPushButton#saleSecondaryButton {
    background-color: #EEF3FC;
    color: #244B8F;
    border: 1px solid #D8E2F3;
    border-radius: 5px;
    padding: 2px 6px;
}
QPushButton#saleSecondaryButton:hover {
    background-color: #E2EBFB;
}
QTableWidget#saleInvoiceLines, QTableWidget#saleInvoiceListTable {
    background-color: #FFFFFF;
    color: #1B2430;
    border: 1px solid #E2E6ED;
    border-radius: 6px;
    gridline-color: #E8ECF2;
    alternate-background-color: #F7F8FA;
}
QTableWidget#saleInvoiceLines QHeaderView::section,
QTableWidget#saleInvoiceListTable QHeaderView::section {
    background-color: #EEF1F6;
    color: #1F2A44;
    padding: 0px 6px;
    border: none;
    border-bottom: 1px solid #DDE3EC;
    font-weight: 700;
}
QTableWidget#saleInvoiceLines QDoubleSpinBox,
QTableWidget#saleInvoiceLines QComboBox {
    padding: 1px 3px;
    border-radius: 3px;
    font-size: 9pt;
}
QDialog#saleInvoiceFormScreen QLineEdit,
QDialog#saleInvoiceFormScreen QComboBox,
QDialog#saleInvoiceFormScreen QDoubleSpinBox,
QDialog#saleInvoiceFormScreen QDateEdit,
QWidget#saleInvoiceListScreen QLineEdit,
QWidget#saleInvoiceListScreen QComboBox,
QWidget#saleInvoiceListScreen QDateEdit {
    padding: 2px 5px;
    min-height: 20px;
    font-size: 9pt;
}
QDialog#saleInvoiceFormScreen QPushButton,
QWidget#saleInvoiceListScreen QPushButton {
    padding: 3px 7px;
    min-height: 21px;
    font-size: 9pt;
}
QDialog#saleInvoiceFormScreen QCheckBox,
QWidget#saleInvoiceListScreen QCheckBox {
    font-size: 9pt;
}
QTableWidget#saleInvoiceLines QTableCornerButton::section,
QTableWidget#saleInvoiceListTable QTableCornerButton::section {
    background-color: #EEF1F6;
    border: none;
}

/* ---------- Lists / Trees / Tables ---------- */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #FFFFFF;
    color: #1B2430;
    border: none;
    border-radius: 0px;
    alternate-background-color: #F4F6F9;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    color: #1B2430;
    padding: 5px 6px;
    border-radius: 0px;
}
QTreeWidget::item:hover {
    background-color: #EAF0FE;
}
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background-color: #2F6FED;
    color: #FFFFFF;
}
QHeaderView::section {
    background-color: #EEF1F6;
    color: #1B2430;
    padding: 6px;
    border: none;
    font-weight: 600;
}

/* ---------- ScrollArea / Splitter ---------- */
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: transparent;
    border: 1px solid #C7CEDA;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    border: 1px solid #2F6FED;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: transparent;
    border: 1px solid #C7CEDA;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    border: 1px solid #2F6FED;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
QSplitter::handle {
    background-color: #E2E6ED;
}

/* ---------- Status bar ---------- */
QStatusBar {
    background-color: #1F2A44;
    color: #FFFFFF;
}
QStatusBar QLabel {
    color: #FFFFFF;
}

/* ---------- Menu ---------- */
QMenuBar {
    background-color: #1F2A44;
    color: #FFFFFF;
}
QMenuBar::item {
    background: transparent;
    color: #FFFFFF;
}
QMenuBar::item:selected {
    background-color: #2F6FED;
    color: #FFFFFF;
}
QMenu {
    background-color: #FFFFFF;
    color: #1B2430;
    border: 1px solid #E2E6ED;
}
QMenu::item:selected {
    background-color: #2F6FED;
    color: #FFFFFF;
}

/* ---------- Feedback labels ---------- */
QLabel#lblLoginMessage {
    color: #D63333;
    font-weight: 600;
}
QLabel#lblCapsLock {
    color: #B8860B;
    font-weight: 600;
}
QLabel#lblConnectionStatus {
    color: #2E9E5B;
    font-weight: 600;
}

/* ---------- Tooltips ---------- */
QToolTip {
    background-color: #1F2A44;
    color: #FFFFFF;
    border: 1px solid #2F6FED;
    padding: 4px 8px;
    border-radius: 4px;
}
/* ---------- Dashboard sidebar tree: bigger, bold ---------- */
QTreeWidget#treeSidebarMenu {
    font-size: 11.5pt;
}
QTreeWidget#treeSidebarMenu::item {
    padding: 7px 6px;
}
/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: 1px solid #E2E6ED;
    background-color: #F4F6F9;
}
QTabBar::tab {
    background-color: #FFFFFF;
    color: #1B2430;
    padding: 6px 14px;
    border: 1px solid #E2E6ED;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #EAF0FE;
    color: #1B2430;
    border-bottom: 2px solid #2F6FED;
}
QTabBar::tab:hover:!selected {
    background-color: #EAF0FE;
    color: #1B2430;
}
QTabBar::tab:disabled {
    background-color: #C6CDDA;
    color: #8A93A3;
}