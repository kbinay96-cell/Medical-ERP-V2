/* =========================================================
   Medical ERP V2 - LIGHT THEME
   ---------------------------------------------------------
   Rule followed throughout: every selector that sets a
   background ALSO sets a matching foreground, and vice
   versa. Nothing is left to inherit from the OS palette -
   that inheritance is exactly what caused the white-on-white
   bug. This file is the single source of truth for Light
   mode across the WHOLE application (Login, Dashboard, and
   every future module screen), since every screen shares
   these same base widget classes.
   ========================================================= */

* {
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10.5pt;
    color: #1B2430;
}

QMainWindow, QDialog, QWidget {
    background-color: #F4F6F9;
    color: #1B2430;
}

/* ---------- Brand header / footer bars ---------- */
QFrame#frmHeader, QFrame#frmTopHeader, QFrame#frmFooter {
    background-color: #1F2A44;
    color: #FFFFFF;
}
QFrame#frmHeader QLabel, QFrame#frmTopHeader QLabel, QFrame#frmFooter QLabel {
    color: #FFFFFF;
    background: transparent;
}

/* ---------- Left branding panel (Login) ---------- */
QFrame#frmLeftPanel {
    background-color: #24304D;
    color: #E6EDF7;
}
QFrame#frmLeftPanel QLabel {
    color: #E6EDF7;
    background: transparent;
}
QLabel#lblWelcomeMessage {
    color: #FFFFFF;
    font-size: 16pt;
    font-weight: 700;
}
QLabel#lblTagline {
    color: #9FB3D1;
    font-style: italic;
}

/* ---------- Login card / Sidebar (light surfaces) ---------- */
QFrame#frmLoginPanel, QFrame#frmSidebar, QFrame#loginCard {
    background-color: #FFFFFF;
    color: #1B2430;
    border-radius: 10px;
}
QFrame#frmLoginPanel QLabel, QFrame#frmSidebar QLabel, QFrame#loginCard QLabel {
    color: #1B2430;
    background: transparent;
}

/* ---------- Generic labels everywhere else ---------- */
QLabel {
    color: #1B2430;
    background: transparent;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #2F6FED;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    padding: 6px 14px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #4A85FF;
    color: #FFFFFF;
}
QPushButton:pressed {
    background-color: #1E52C4;
    color: #FFFFFF;
}
QPushButton:disabled {
    background-color: #C6CDDA;
    color: #8A93A3;
}

QPushButton[flat="true"] {
    background-color: transparent;
    color: #2F6FED;
    text-decoration: underline;
    padding: 4px 6px;
}
QPushButton[flat="true"]:hover {
    color: #1E52C4;
    background-color: transparent;
}

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QSpinBox, QDateEdit {
    padding: 5px 7px;
    border: 1px solid #C7CEDA;
    border-radius: 2px;
    background-color: #FFFFFF;
    color: #1B2430;
    selection-background-color: #2F6FED;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #2F6FED;
}
QLineEdit::placeholder {
    color: #8A93A3;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1B2430;
    border: 1px solid #C7CEDA;
    selection-background-color: #2F6FED;
    selection-color: #FFFFFF;
}

/* ---------- Checkboxes / Radio ---------- */
QCheckBox, QRadioButton {
    color: #1B2430;
    background: transparent;
    spacing: 6px;
}

/* ---------- Group boxes ---------- */
QGroupBox {
    color: #1B2430;
    font-weight: 600;
    border: none;
    border-top: 1px solid #E2E6ED;
    border-radius: 0px;
    margin-top: 8px;
    padding-top: 10px;
    background-color: transparent;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #1B2430;
    background-color: #FFFFFF;
}

/* ---------- KPI cards ---------- */
QFrame[cssClass="kpiCard"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E6ED;
    border-radius: 10px;
}
QFrame[cssClass="kpiCard"] QLabel[cssClass="kpiTitle"] {
    color: #5B6472;
    font-weight: 600;
    font-size: 9.5pt;
}
QFrame[cssClass="kpiCard"] QLabel[cssClass="kpiValue"] {
    color: #1F2A44;
    font-weight: 700;
    font-size: 16pt;
}

/* ---------- Lists / Trees / Tables ---------- */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #FFFFFF;
    color: #1B2430;
    border: none;
    border-radius: 0px;
    alternate-background-color: #F4F6F9;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    color: #1B2430;
    padding: 5px 6px;
    border-radius: 0px;
}
QTreeWidget::item:hover {
    background-color: #EAF0FE;
}
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background-color: #2F6FED;
    color: #FFFFFF;
}
QHeaderView::section {
    background-color: #EEF1F6;
    color: #1B2430;
    padding: 6px;
    border: none;
    font-weight: 600;
}

/* ---------- ScrollArea / Splitter ---------- */
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: transparent;
    border: 1px solid #C7CEDA;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    border: 1px solid #2F6FED;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: transparent;
    border: 1px solid #C7CEDA;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    border: 1px solid #2F6FED;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
QSplitter::handle {
    background-color: #E2E6ED;
}

/* ---------- Status bar ---------- */
QStatusBar {
    background-color: #1F2A44;
    color: #FFFFFF;
}
QStatusBar QLabel {
    color: #FFFFFF;
}

/* ---------- Menu ---------- */
QMenuBar {
    background-color: #1F2A44;
    color: #FFFFFF;
}
QMenuBar::item {
    background: transparent;
    color: #FFFFFF;
}
QMenuBar::item:selected {
    background-color: #2F6FED;
    color: #FFFFFF;
}
QMenu {
    background-color: #FFFFFF;
    color: #1B2430;
    border: 1px solid #E2E6ED;
}
QMenu::item:selected {
    background-color: #2F6FED;
    color: #FFFFFF;
}

/* ---------- Feedback labels ---------- */
QLabel#lblLoginMessage {
    color: #D63333;
    font-weight: 600;
}
QLabel#lblCapsLock {
    color: #B8860B;
    font-weight: 600;
}
QLabel#lblConnectionStatus {
    color: #2E9E5B;
    font-weight: 600;
}

/* ---------- Tooltips ---------- */
QToolTip {
    background-color: #1F2A44;
    color: #FFFFFF;
    border: 1px solid #2F6FED;
    padding: 4px 8px;
    border-radius: 4px;
}
/* ---------- Dashboard sidebar tree: bigger, bold ---------- */
QTreeWidget#treeSidebarMenu {
    font-size: 11.5pt;
    font-weight: 600;
}
QTreeWidget#treeSidebarMenu::item {
    padding: 6px 4px;
}